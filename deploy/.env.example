# Copy to .env next to compose.yaml. Never commit .env. Secrets (database passwords, first
# administrator's password, Anthropic key, MFA key, SMTP password) are not here: run
# deploy/init-secrets.sh, they live in deploy/secrets/.

# Public host name of this instance (DNS A/AAAA record must point at this server before the first start).
OS_DOMAIN=os.cliente.com.br

# Where deploy/update.sh <tag> pulls os-api and os-web from. The CD workflow pushes to the fork's
# GitHub Container Registry (ghcr.io/<owner>) and fills OS_IMAGE_TAG with the deployed commit.
OS_IMAGE_REPOSITORY=ghcr.io/<owner>
OS_IMAGE_TAG=latest

# First administrator, created only when the users table is empty. The password is generated in
# deploy/secrets/bootstrap_admin_password and must be replaced on first login. Remove these two
# lines and empty that file after the first start.
OS_BOOTSTRAP_ADMIN_EMAIL=
OS_BOOTSTRAP_ADMIN_NAME=

# Backups (deploy/backup.sh). Encrypt with age: generate a key pair OFF this server (age-keygen),
# put the public key here and keep the private key with the people who may restore.
BACKUP_AGE_RECIPIENT=age1...
BACKUP_KEEP_DAYS=14
# Optional: command that copies each backup off the host; receives the file path as argument.
#BACKUP_UPLOAD_CMD=rclone copyto --config /opt/os/rclone.conf

# Only with a load balancer (or CDN) in front of Caddy: the CIDRs it connects to Caddy from, separated
# by spaces. Caddy then takes the client's address from X-Forwarded-For (right to left, skipping these
# ranges); otherwise every visitor shares the balancer's address in rate limits and the audit trail.
# Empty or absent: Caddy trusts no proxy and ignores X-Forwarded-* from outside (Caddyfile). List
# only the balancer's own ranges: anything listed here can claim to be any client.
#OS_TRUSTED_PROXIES=203.0.113.0/24

# SMTP, REQUIRED: the API does not start in production without SPRING_MAIL_HOST and OS_MAIL_FROM.
# Invitations and password resets are delivered only by e-mail, because receiving the invitation
# is what proves the address belongs to the person. SPRING_MAIL_USERNAME and secrets/mail_password
# are required when the SMTP server authenticates (any provider on the internet does).
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
OS_MAIL_FROM=OS <no-reply@cliente.com.br>
OS_MAIL_PORTAL_NAME=OS
