# Copy to .env next to compose.yaml. Never commit .env.

# Public host name of this instance (DNS A/AAAA record must point at this server before the first start).
OS_DOMAIN=os.cliente.com.br

# Postgres password for the "os" user. Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# Anthropic API key used by the assistant.
ANTHROPIC_API_KEY=

# First administrator, created only when the users table is empty. The person must replace this
# password on first login. Remove these three lines after the first start.
OS_BOOTSTRAP_ADMIN_EMAIL=
OS_BOOTSTRAP_ADMIN_PASSWORD=
OS_BOOTSTRAP_ADMIN_NAME=

# Optional SMTP for invitation and password-reset e-mails. Without SPRING_MAIL_HOST, invitation
# links are shown to the administrator in the portal instead.
OS_MAIL_FROM=OS <no-reply@cliente.com.br>
OS_MAIL_PORTAL_NAME=OS
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
