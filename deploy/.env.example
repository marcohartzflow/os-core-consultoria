# Copy to .env next to compose.yaml. Never commit .env. Secrets (database password, Anthropic key,
# MFA key, SMTP password) are not here: run deploy/init-secrets.sh, they live in deploy/secrets/.

# Public host name of this instance (DNS A/AAAA record must point at this server before the first start).
OS_DOMAIN=os.cliente.com.br

# Where deploy/update.sh <tag> pulls os-api and os-web from. The CD workflow pushes to the fork's
# GitHub Container Registry (ghcr.io/<owner>) and fills OS_IMAGE_TAG with the deployed commit.
OS_IMAGE_REPOSITORY=ghcr.io/<owner>
OS_IMAGE_TAG=latest

# First administrator, created only when the users table is empty. The person must replace this
# password on first login. Remove these three lines after the first start.
OS_BOOTSTRAP_ADMIN_EMAIL=
OS_BOOTSTRAP_ADMIN_PASSWORD=
OS_BOOTSTRAP_ADMIN_NAME=

# Backups (deploy/backup.sh). Encrypt with age: generate a key pair OFF this server (age-keygen),
# put the public key here and keep the private key with the people who may restore.
BACKUP_AGE_RECIPIENT=age1...
BACKUP_KEEP_DAYS=14
# Optional: command that copies each backup off the host; receives the file path as argument.
#BACKUP_UPLOAD_CMD=rclone copyto --config /opt/os/rclone.conf

# Behind a cloud load balancer with a public address (not the Compose Caddy), tell Tomcat which
# proxies may set X-Forwarded-*: otherwise every visitor shares the proxy's address for rate limits
# and the audit trail. Regular expression over the proxy addresses.
#SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=203\.0\.113\.\d{1,3}

# Optional SMTP for invitation and password-reset e-mails. Without SPRING_MAIL_HOST, invitation
# links are shown to the administrator in the portal instead.
OS_MAIL_FROM=OS <no-reply@cliente.com.br>
OS_MAIL_PORTAL_NAME=OS
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
